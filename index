            {
                id: 8,
                name: "Dark Berry & Hibiscus Sorbet",
                category: "vegan",
                categoryLabel: "Vegan & Sorbet",
                origin: "Willamette Valley, AS",
                shortDesc: "Sorbet beri hutan liar dengan seduhan kelopak bunga rosella merah.",
                fullDesc: "Kombinasi blackberry, blackcurrant, dan blueberry yang diinfusi dengan teh hibiscus organik, menghasilkan warna merah delima alami yang memikat.",
                notes: "Beri segar yang tajam, aroma herbal hibiscus, ringan.",
                price: 84000,
                image: "https://images.unsplash.com/photo-1488900128323-21503983a07e?auto=format&fit=crop&w=800&q=85",
                fallbackBg: "F3E2E8"
            }
        ];

        // 2. DATA LOKASI CABANG GLOBAL
        const locationsData = [
            {
                city: "Paris (Flagship)",
                country: "Prancis",
                region: "eropa",
                address: "42 Rue Saint-Honoré, 75001 Paris",
                hours: "10:00 – 22:30 CET",
                badge: "Butik Pusat"
            },
            {
                city: "Jakarta",
                country: "Indonesia",
                region: "asia",
                address: "Pacific Place Mall Lt. 1, SCBD, Jakarta Selatan",
                hours: "10:00 – 22:00 WIB",
                badge: "Asia Flagship"
            },
            {
                city: "Tokyo",
                country: "Jepang",
                region: "asia",
                address: "Ginza Six 2F, Chuo-ku, Tokyo",
                hours: "10:30 – 21:00 JST",
                badge: "Tea & Gelato Lounge"
            },
            {
                city: "London",
                country: "Inggris",
                region: "eropa",
                address: "18 New Bond Street, Mayfair, London",
                hours: "11:00 – 22:00 GMT",
                badge: "Butik Eksklusif"
            },
            {
                city: "New York",
                country: "Amerika Serikat",
                region: "amerika",
                address: "458 Broome St, SoHo, New York, NY",
                hours: "11:00 – 23:00 EST",
                badge: "Americas Hub"
            },
            {
                city: "Singapura",
                country: "Singapura",
                region: "asia",
                address: "Marina Bay Sands, Canal Level B2",
                hours: "10:00 – 22:30 SGT",
                badge: "Butik Resort"
            }
        ];

        // STATE KERANJANG & MODAL
        let cart = [];
        let currentModalFlavor = null;

        // FORMAT RUPIAH
        function formatRupiah(num) {
            return 'Rp ' + num.toLocaleString('id-ID');
        }

        // TAMPILKAN TOAST NOTIFIKASI
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            if (!toast || !toastMsg) return;
            toastMsg.textContent = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }

        // 3. RENDER KATALOG VARIAN RASA DENGAN FOTO REAL
        function renderFlavors(filter = 'all') {
            const grid = document.getElementById('flavors-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const filtered = filter === 'all' 
                ? flavorsData 
                : flavorsData.filter(item => item.category === filter);

            filtered.forEach(flavor => {
                const fallbackUrl = `https://placehold.co/600x450/${flavor.fallbackBg}/2C1810?text=${encodeURIComponent(flavor.name)}`;
                const card = document.createElement('div');
                card.className = "group bg-cream rounded-3xl border border-espresso/10 hover:border-caramel overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between";
                
                card.innerHTML = `
                    <div>
                        <!-- Area Foto Real Produk -->
                        <div onclick="openFlavorModal(${flavor.id})" class="h-52 relative overflow-hidden bg-creamDark cursor-pointer">
                            <img 
                                src="${flavor.image}" 
                                alt="${flavor.name}" 
                                loading="lazy"
                                onerror="this.onerror=null;this.src='${fallbackUrl}';"
                                class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700 ease-out"
                            >
                            <div class="absolute inset-0 bg-gradient-to-t from-espresso/45 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
                            <span class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full bg-cream/95 backdrop-blur-xs text-[11px] font-bold text-espresso shadow-sm">
                                ${flavor.categoryLabel}
                            </span>
                            <span class="absolute bottom-3 right-3.5 px-2.5 py-1 rounded-full bg-espresso/85 text-cream text-xs font-serif font-semibold backdrop-blur-xs">
                                ${formatRupiah(flavor.price)}
                            </span>
                        </div>

                        <!-- Konten Kartu -->
                        <div class="p-5 sm:p-6 space-y-2.5">
                            <div class="flex items-center gap-1.5 text-xs text-caramelDark font-semibold">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>${flavor.origin}</span>
                            </div>
                            <h3 onclick="openFlavorModal(${flavor.id})" class="font-serif text-xl font-bold text-espresso group-hover:text-caramelDark transition-colors cursor-pointer">
                                ${flavor.name}
                            </h3>
                            <p class="text-xs sm:text-sm text-espresso/70 leading-relaxed line-clamp-2">
                                ${flavor.shortDesc}
                            </p>
                        </div>
                    </div>

                    <!-- Footer Kartu -->
                    <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 flex items-center justify-between gap-2 border-t border-espresso/5">
                        <button onclick="openFlavorModal(${flavor.id})" class="text-xs font-bold text-espresso hover:text-caramelDark underline underline-offset-4 py-2 transition-colors">
                            Lihat Detail
                        </button>
                        <button onclick="addToCart(${flavor.id})" class="px-4 py-2 rounded-full bg-creamDark hover:bg-espresso text-espresso hover:text-cream text-xs font-semibold transition-all flex items-center gap-1.5">
                            <i class="fa-solid fa-plus"></i>
                            <span>Pilih</span>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // FILTER KATALOG EVENT LISTENER
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => {
                    b.classList.remove('active', 'bg-espresso', 'text-cream', 'shadow-md');
                    b.classList.add('bg-creamDark', 'text-espresso');
                });
                btn.classList.add('active', 'bg-espresso', 'text-cream', 'shadow-md');
                btn.classList.remove('bg-creamDark', 'text-espresso');
                renderFlavors(btn.dataset.filter);
            });
        });

        // 4. MODAL DETAIL RASA DENGAN FOTO REAL
        function openFlavorModal(id) {
            const flavor = flavorsData.find(f => f.id === id);
            if (!flavor) return;
            currentModalFlavor = flavor;

            const modal = document.getElementById('flavor-modal');
            const modalImg = document.getElementById('modal-image');
            const fallbackUrl = `https://placehold.co/800x500/${flavor.fallbackBg}/2C1810?text=${encodeURIComponent(flavor.name)}`;
            
            modalImg.src = flavor.image;
            modalImg.alt = flavor.name;
            modalImg.onerror = function() {
                this.onerror = null;
                this.src = fallbackUrl;
            };

            document.getElementById('modal-category').textContent = flavor.categoryLabel;
            document.getElementById('modal-origin').querySelector('span').textContent = flavor.origin;
            document.getElementById('modal-title').textContent = flavor.name;
            document.getElementById('modal-desc').textContent = flavor.fullDesc;
            document.getElementById('modal-notes').textContent = flavor.notes;
            document.getElementById('modal-price').textContent = formatRupiah(flavor.price);

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        document.getElementById('close-modal-btn').addEventListener('click', () => {
            const modal = document.getElementById('flavor-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        });

        document.getElementById('flavor-modal').addEventListener('click', (e) => {
            if (e.target.id === 'flavor-modal') {
                e.target.classList.add('hidden');
                e.target.classList.remove('flex');
            }
        });

        document.getElementById('modal-add-btn').addEventListener('click', () => {
            if (currentModalFlavor) {
                addToCart(currentModalFlavor.id);
                const modal = document.getElementById('flavor-modal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        });

        // 5. RENDER LOKASI CABANG GLOBAL
        function renderLocations(region = 'all') {
            const grid = document.getElementById('locations-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const filtered = region === 'all'
                ? locationsData
                : locationsData.filter(loc => loc.region === region);

            filtered.forEach(loc => {
                const card = document.createElement('div');
                card.className = "bg-white/5 hover:bg-white/10 border border-white/10 hover:border-caramel/50 rounded-3xl p-6 transition-all duration-300 space-y-4";
                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <span class="px-3 py-1 rounded-full bg-caramel/20 text-caramel text-xs font-bold">
                            ${loc.badge}
                        </span>
                        <span class="text-xs text-cream/60 font-medium">${loc.country}</span>
                    </div>
                    <div>
                        <h3 class="font-serif text-2xl font-bold text-cream">${loc.city}</h3>
                        <p class="text-sm text-cream/75 mt-1.5 flex items-start gap-2">
                            <i class="fa-solid fa-location-dot text-caramel mt-1 shrink-0"></i>
                            <span>${loc.address}</span>
                        </p>
                    </div>
                    <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-cream/70">
                        <span class="flex items-center gap-1.5">
                            <i class="fa-regular fa-clock text-caramel"></i> ${loc.hours}
                        </span>
                        <span class="text-caramel font-semibold">Buka</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        document.querySelectorAll('.region-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.region-btn').forEach(b => {
                    b.classList.remove('active', 'bg-caramel', 'text-espresso');
                    b.classList.add('bg-white/10', 'text-cream');
                });
                btn.classList.add('active', 'bg-caramel', 'text-espresso');
                btn.classList.remove('bg-white/10', 'text-cream');
                renderLocations(btn.dataset.region);
            });
        });

        // 6. KERANJANG / KOTAK PILIHAN RASA
        function addToCart(id) {
            const flavor = flavorsData.find(f => f.id === id);
            if (!flavor) return;

            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...flavor, qty: 1 });
            }
            updateCartUI();
            showToast(`${flavor.name} ditambahkan ke kotak pilihan!`);
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const totalEl = document.getElementById('cart-total');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            if (badge) badge.textContent = totalQty;
            if (totalEl) totalEl.textContent = formatRupiah(totalPrice);

            if (!container) return;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 space-y-3">
                        <div class="w-14 h-14 rounded-full bg-creamDark mx-auto flex items-center justify-center text-espresso/40">
                            <i class="fa-solid fa-ice-cream text-2xl"></i>
                        </div>
                        <p class="font-serif text-lg font-semibold text-espresso">Kotak Pilihan Masih Kosong</p>
                        <p class="text-xs text-espresso/60 max-w-xs mx-auto">Pilih varian es krim artisan favorit Anda dari katalog untuk dipesan di gerai terdekat.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = cart.map(item => {
                const fallbackUrl = `https://placehold.co/120x120/${item.fallbackBg}/2C1810?text=Ice`;
                return `
                    <div class="flex items-center justify-between gap-3 bg-creamDark/60 p-3.5 rounded-2xl border border-espresso/10">
                        <div class="flex items-center gap-3">
                            <img src="${item.image}" alt="${item.name}" onerror="this.onerror=null;this.src='${fallbackUrl}';" class="w-12 h-12 rounded-xl object-cover shrink-0 border border-espresso/10">
                            <div>
                                <h4 class="font-serif font-bold text-sm text-espresso">${item.name}</h4>
                                <p class="text-xs text-espresso/65">${item.qty}x • ${formatRupiah(item.price)}</p>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-espresso/45 hover:text-berry p-2 transition-colors" aria-label="Hapus item">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
            }).join('');
        }

        // Buka / Tutup Drawer Keranjang
        const cartDrawer = document.getElementById('cart-drawer');
        document.getElementById('open-cart-btn').addEventListener('click', () => {
            cartDrawer.classList.remove('hidden');
            cartDrawer.classList.add('flex');
        });

        document.getElementById('close-cart-btn').addEventListener('click', () => {
            cartDrawer.classList.add('hidden');
            cartDrawer.classList.remove('flex');
        });

        cartDrawer.addEventListener('click', (e) => {
            if (e.target.id === 'cart-drawer') {
                cartDrawer.classList.add('hidden');
                cartDrawer.classList.remove('flex');
            }
        });

        document.getElementById('checkout-btn').addEventListener('click', () => {
            if (cart.length === 0) {
                showToast('Silakan pilih minimal 1 varian rasa terlebih dahulu.');
                return;
            }
            cart = [];
            updateCartUI();
            cartDrawer.classList.add('hidden');
            cartDrawer.classList.remove('flex');
            showToast('Reservasi kotak rasa Anda berhasil dikirim ke butik!');
        });

        // 7. MENU MOBILE & FORMULIR
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Validasi Formulir Franchise
        document.getElementById('franchise-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('f-name').value.trim();
            const email = document.getElementById('f-email').value.trim();
            const phone = document.getElementById('f-phone').value.trim();
            const city = document.getElementById('f-city').value.trim();
            const feedback = document.getElementById('form-feedback');

            if (!name || !email || !phone || !city) {
                feedback.className = "p-4 rounded-xl text-sm font-medium bg-berry/15 text-berry border border-berry/30";
                feedback.textContent = "Mohon lengkapi semua kolom bertanda bintang (*) sebelum mengirim.";
                feedback.classList.remove('hidden');
                return;
            }

            feedback.className = "p-4 rounded-xl text-sm font-medium bg-mint/15 text-mint border border-mint/30";
            feedback.textContent = `Terima kasih, ${name}! Permohonan kemitraan untuk wilayah ${city} telah kami terima. Tim Paris HQ akan segera menghubungi Anda.`;
            feedback.classList.remove('hidden');
            this.reset();
        });

        // Newsletter Form
        document.getElementById('newsletter-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const msg = document.getElementById('newsletter-msg');
            msg.textContent = "Terima kasih telah bergabung dengan Buletin Musiman Lumière!";
            msg.classList.remove('hidden');
            this.reset();
        });

        // Animasi Reveal saat Scroll
        function handleReveal() {
            document.querySelectorAll('.reveal').forEach(el => {
                const top = el.getBoundingClientRect().top;
                if (top < window.innerHeight - 80) {
                    el.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', handleReveal);
        window.addEventListener('DOMContentLoaded', () => {
            renderFlavors();
            renderLocations();
            updateCartUI();
            handleReveal();
        });
    </script>
</body>
</html>
